APP_NAME='links-analyzer'
APP_ENV='example'
APP_DEBUG=true

# Postgres
POSTGRES_DB='links_analyzer_db'
POSTGRES_USER='links_analyzer'
POSTGRES_PASSWORD='links_analyzer'
POSTGRES_HOST='postgres'
POSTGRES_PORT=5432

# Redis
REDIS_HOST='redis'
REDIS_PORT=6379

# Настройки HTTP
# Максимальное время загрузки одного URL (aiohttp)
FETCH_TIMEOUT_SECONDS=10
# Количество паралельных запросорв (asyncio)
FETCH_CONCURRENCY=10
# Максимальный размер загружаемого ответа
FETCH_MAX_RESPONSE_SIZE_BYTES=2000000
# Значение HTTP-заголовка User-Agent
FETCH_USER_AGENT='LinkWebsiteAnalyzer/0.1'

# Настройки парсера
# Максимальное количество параллельных потоков (workers)
HTML_PARSER_MAX_WORKERS=4
# Максимальная длина Title страницы, для БД
HTML_PARSER_MAX_TITLE_LENGTH=512
# Максимальная длина Description страницы, для БД
HTML_PARSER_MAX_DESCRIPTION_LENGTH=2000